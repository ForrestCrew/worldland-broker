# =====================================================
# WORLDLAND HUB ENVIRONMENT CONFIGURATION
# =====================================================
# Copy to .env and customize as needed
# Defaults work with docker-compose for local development
#
# Usage:
#   cp .env.example .env
#   # Edit .env as needed
#   export $(cat .env | xargs) && ./hub

# =====================================================
# DATABASE
# =====================================================
# PostgreSQL connection settings
# Defaults match docker-compose.yml for local development

# PostgreSQL host (use 'postgres' when running Hub in Docker)
DB_HOST=localhost

# PostgreSQL port
DB_PORT=5432

# Database user (must match POSTGRES_USER in docker-compose.yml)
DB_USER=worldland

# Database password (must match POSTGRES_PASSWORD in docker-compose.yml)
# WARNING: Change this in production!
DB_PASSWORD=devpassword

# Database name (must match POSTGRES_DB in docker-compose.yml)
DB_NAME=worldland_hub

# =====================================================
# SERVER
# =====================================================
# Hub server port configuration

# HTTP API port (public endpoints, authentication, rentals)
# Frontend and external clients connect here
SERVER_PORT=8080

# mTLS port (Node connections only)
# GPU Nodes connect here with mutual TLS
MTLS_PORT=8443

# =====================================================
# AUTHENTICATION
# =====================================================
# Sign-In With Ethereum (SIWE) configuration

# Domain for SIWE message verification
# Must match exactly what frontend uses when signing
# Example: If frontend signs with domain "hub.worldland.io",
#          Hub must verify against the same domain
SIWE_DOMAIN=hub.worldland.io

# =====================================================
# BLOCKCHAIN EVENT LISTENER
# =====================================================
# Configuration for listening to WorldlandRental contract events
# Required for: deposit tracking, rental events, settlement

# Deployed WorldlandRental contract address
# Leave empty to disable blockchain integration (useful for local dev)
# Example: 0x1234567890abcdef1234567890abcdef12345678
CONTRACT_ADDRESS=

# WebSocket RPC endpoint(s) for event subscription
# Comma-separated for multiple endpoints (automatic failover)
# Used for: real-time event listening (Deposited, Withdrawn, RentalStarted, etc.)
BLOCKCHAIN_RPC_ENDPOINTS=wss://bsc-ws-node.nariox.org:443

# HTTP RPC endpoint for contract calls
# Used for: balance queries, getDeposit() calls
BLOCKCHAIN_HTTP_RPC=https://bsc-dataseed1.binance.org

# Block number when contract was deployed
# Used for initial backfill of historical events
# Set to 0 to skip backfill (not recommended for production)
CONTRACT_DEPLOYMENT_BLOCK=0

# Enable/disable blockchain event listener (true/false)
# Set to false for local development without blockchain
BLOCKCHAIN_LISTENER_ENABLED=true

# =====================================================
# mTLS CERTIFICATES
# =====================================================
# Mutual TLS configuration for secure Hub-Node communication
# In development, Hub auto-generates self-signed certs if files don't exist

# === CA Certificates ===
# Path to CA certificate (from step-ca or your CA)
# Nodes use this to verify Hub identity
CA_CERT_PATH=./dev/step-ca/certs/root_ca.crt

# Path to CA private key (for signing node certificates)
CA_KEY_PATH=./dev/step-ca/secrets/root_ca_key

# === Hub Server Certificates ===
# Certificate and key for Hub's mTLS server
# Nodes connect to Hub using these credentials
MTLS_CERT_PATH=./dev/certs/hub.crt
MTLS_KEY_PATH=./dev/certs/hub.key

# === Hub Client Certificates (Hub-to-Node) ===
# Certificate and key for Hub connecting to Nodes
# Used when Hub sends commands to Nodes (start/stop rental)
NODE_CLIENT_CERT_PATH=certs/hub-client.crt
NODE_CLIENT_KEY_PATH=certs/hub-client.key

# =====================================================
# STEP-CA (ACME)
# =====================================================
# Automatic certificate issuance via step-ca ACME
# Used for automatic certificate renewal

# ACME directory URL for certificate requests
# Points to step-ca's ACME endpoint
ACME_DIRECTORY_URL=https://localhost:9000/acme/acme/directory
